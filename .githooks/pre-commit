#!/bin/sh
# 規約を機械的に守らせる門。
#
# --no-verify による迂回は許容する。技術的に塞げないし、フックは強制装置ではなく
# 規律の道具として置いている。**塞げないぶん、CI が同じ門をもう一度通す。**
#
# 呼び方は3つ。門の中身は1つ（ここ）しかない。
#
#   pre-commit                          git フック。ステージした差分を見る
#   pre-commit --all                    追跡中の全ファイルを対象にする（CI）
#   pre-commit --against <ref>          <ref> との差分で不変層を見る（CI の PR）
#
# --all と --against は併用できる。CI は両方渡して「テストと schema は必ず回し、
# 不変層は PR の差分で見る」にする。
set -e

root=$(git rev-parse --show-toplevel)
cd "$root"

all=0
base=""
while [ $# -gt 0 ]; do
    case "$1" in
        --all) all=1 ;;
        --against)
            [ -n "$2" ] || { echo "--against にはリビジョンが要る" >&2; exit 2; }
            base=$2
            shift
            ;;
        *) echo "不明な引数: $1" >&2; exit 2 ;;
    esac
    shift
done

if [ "$all" = 1 ]; then
    # CI では「何を触ったか」で門を選り分けない。全部通す。
    staged=$(git ls-files)
else
    staged=$(git diff --cached --name-only --diff-filter=ACMR)
fi

# 1. tools / tests を触ったらテスト
if echo "$staged" | grep -qE '^(tools|tests)/'; then
    echo "pre-commit: テスト"
    python3 -m unittest discover -s tests -q
fi

# 2. ontology.yaml / 雛形を触ったら生成物と雛形の鮮度
if echo "$staged" | grep -qE '^(ontology\.yaml|templates/|schema\.md)'; then
    echo "pre-commit: schema.md と雛形の同期"
    python3 tools/giji.py schema --check --check-samples --check-templates
fi

# 3. lint（error で落ちる。warning は落とさない）
# `.fixture` があるディレクトリは教材。意図的に error を含むので自動検査から外す。
# `.wip` は作りかけの案件。完成するまで error が出るのは当たり前なので外す。
for project in projects/*/; do
    [ -d "$project" ] || continue
    [ -f "$project/.fixture" ] && continue
    [ -f "$project/.wip" ] && continue
    echo "pre-commit: lint $project"
    python3 tools/giji.py lint --root "$project"
done

# 4. ビューの鮮度
for project in projects/*/; do
    [ -d "$project" ] || continue
    [ -f "$project/.fixture" ] && continue
    [ -f "$project/.wip" ] && continue
    if [ -d "$project/views" ]; then
        python3 tools/giji.py views --root "$project" --check
    fi
done

# 5. 不変層 — 文字起こし原本と LOG カードの改変を拒む（追加・削除は許す）
# 比較先が無いとき（--all だけで呼ばれたとき）は見ない。差分が定義できないため。
if [ -n "$base" ]; then
    diff_args="--diff-filter=M $base...HEAD"
elif [ "$all" = 0 ]; then
    diff_args="--cached --diff-filter=M"
else
    diff_args=""
fi
if [ -n "$diff_args" ]; then
    # shellcheck disable=SC2086
    changed=$(git diff --name-only $diff_args \
        | grep -E 'meetings/[^/]+/(transcript\.md|logs/LOG-[^/]+\.md)$' || true)
else
    changed=""
fi
if [ -n "$changed" ]; then
    echo "pre-commit: 不変層が書き換えられている"
    echo "$changed" | sed 's/^/  /'
    echo ""
    echo "LOG はすべての引用の照合先です。記録の側が誤っていたと判断した場合だけ、"
    echo "--no-verify を明示して通してください。"
    exit 1
fi

echo "pre-commit: 通過"
